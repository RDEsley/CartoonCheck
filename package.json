{
  "name": "cartoon-check",
  "private": true,
  "version": "0.2.0",
  "description": "Simple shopping lists with a playful cartoon identity.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.18.1",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "budget": "node scripts/check-budgets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "y-dexie": "4.4.0",
    "yjs": "13.6.33"
  }
}
